<?xml version="1.0" encoding="utf-8"?>
<!--
  车机横屏主界面（两栏版面，@dimen/car_* 控制尺寸）。

  实车（IHU801G / E22H___5，Android 9）实测：物理 1920×1080px、密度 160 dpi
  （mdpi / density=1.0），可用内容区 1920×968dp、整屏 sw=1080dp。
  尺寸基准在 values/dimens.xml（xhdpi 2x 默认值）与 values-sw1080dp/dimens.xml
  （低密度真车 ×2 放大值）里切换，本文件只引用 @dimen/car_*，不再写死数值。

  ============================================================
  v2.0 版面重做（参考喜马拉雅 FM）
  ============================================================

  <h3>从「一块深色面板」改成「两张白卡片浮在灰底上」</h3>
  旧版是整屏深色 + 左右两栏同底，信息全糊在一起；新版把内容切成两块卡片：
  左边是这台电台本身（台标、台名、时间轴、三个控制键），右边是电台列表。
  页面底 @color/bg（#F4F5F7）托住两张 @color/panel 的白卡，
  靠明度分层而不是阴影 —— 车内屏幕反光，阴影几乎看不见。

  <h3>高度怎么保证不被压扁</h3>
  左卡内容按「固定 + 两段弹性」排：
     固定区：直播标记 / 台标 / 台名 / 时段 / 副标题 / 时间轴 / 状态
     弹性区：两个 Space 吃掉剩余高度
     锁定区：底部按钮行，永不参与压缩
  installAdaptiveLayout() 仍会在这个基础上兜底：一旦实测溢出，只缩台标，
  按钮行不动 —— 实车最低要求是「按钮能按、台标能认」。

  <h3>为什么按钮是胶囊而不是圆</h3>
  上一台 / 下一台宽度由 weight 等分，做成正圆会变椭圆；
  胶囊 + 无边框更稳，视觉重量全压在图标上。中间主播放键橙底，全场只此一处大面积橙。

  左 46% / 右 54%。这个比例与 PhoneLayout.useTwoColumn 的判据一致，
  改动比例时两边一起看。

  ============================================================
  v2.2.3 按钮行压矮 10%
  ============================================================

  <h3>只改了一处：上一台 / 播放 / 下一台三个键的高度</h3>
  按 v2.2.2 版面，仅把按钮行 car_btn_height 从 176dp 收 10% 到 158dp，
  其余尺寸（含底部边距 car_pad_bottom）一律保持 v2.2.2 不变。

  根布局的 paddingBottom 单独抽成 @dimen/car_pad_bottom，是为了以后调
  底部边距只动一处（值仍是 v2.2.2 的原边距）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/car_space_12"
    android:paddingTop="@dimen/car_space_12"
    android:paddingEnd="@dimen/car_space_12"
    android:paddingBottom="@dimen/car_pad_bottom">

    <!-- ==================== 左：播放卡 ==================== -->
    <!--
      id=panel_left 是滑动换台的接收区（上半区），手势由 SwipeStationHelper 接管。
      logo_wrap 必须保持为这里的<b>直接子 View</b>：
      installAdaptiveLayout() 靠「logo_wrap 的 parent」定位左栏，并遍历其子 View
      统计固定高度。中间套一层容器会让压缩逻辑算错。
    -->
    <LinearLayout
        android:id="@+id/panel_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/car_space_12"
        android:layout_weight="46"
        android:background="@drawable/panel_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/car_space_20"
        android:paddingTop="@dimen/car_space_16"
        android:paddingEnd="@dimen/car_space_20"
        android:paddingBottom="@dimen/car_space_16">

        <!-- 直播标记：橙色圆点 + 文字。点用固定尺寸的 drawable，不用字符「●」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_live"
                android:layout_width="@dimen/car_dot_live"
                android:layout_height="@dimen/car_dot_live"
                android:background="@drawable/dot_live" />

            <TextView
                android:id="@+id/tv_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/car_space_8"
                android:includeFontPadding="false"
                android:text="正在直播"
                android:textColor="@color/accent_deep"
                android:textSize="@dimen/car_text_live" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          台标：圆角方形（v2.0 由圆改方）。
          优先显示央广网官方台标，未下载完/断网/无图时回落「台名首字」字标。
        -->
        <FrameLayout
            android:id="@+id/logo_wrap"
            android:layout_width="@dimen/car_logo_size"
            android:layout_height="@dimen/car_logo_size"
            android:background="@drawable/logo_circle">

            <TextView
                android:id="@+id/tv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="川"
                android:textColor="@color/on_light"
                android:textSize="@dimen/car_text_logo"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/logo_clip"
                android:clipToOutline="true"
                android:contentDescription="电台台标"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 台名 + 收藏键。字重中等（不用 700，避免中文笔画糊成一团） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/car_space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--
              台名单行 + 自动缩字号（v2.2.4）：
              ≤9 个字时 autoSizeTextType 会直接用上限 car_text_station（68sp），观感不变；
              >9 个字时系统按实测宽度等比缩小字号直到单行放下（如 10 字约 61sp、
              14 字约 44sp）；缩到下限 car_text_station_min 仍放不下才显示省略号。
              之前 maxLines=2，长台名折到第二行会把按钮行挤到卡片底边。
            -->
            <TextView
                android:id="@+id/tv_station"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="@dimen/car_text_station_min"
                android:autoSizeMaxTextSize="@dimen/car_text_station"
                android:autoSizeStepGranularity="2sp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:nextFocusRight="@id/btn_fav_playing"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/car_text_station" />

            <!--
              播放卡上的收藏键（圆）。焦点链显式钉死：
              方向盘按「下」必须到「上一台」，不能被系统导航丢到右边列表里。
            -->
            <FrameLayout
                android:id="@+id/btn_fav_playing"
                android:layout_width="@dimen/car_fav_btn_size"
                android:layout_height="@dimen/car_fav_btn_size"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/fav_btn_bg"
                android:clickable="true"
                android:contentDescription="收藏当前电台"
                android:focusable="true"
                android:nextFocusDown="@id/btn_next"
                android:nextFocusLeft="@id/tv_station"
                android:nextFocusUp="@id/tv_station">

                <ImageView
                    android:id="@+id/iv_fav_playing"
                    android:layout_width="@dimen/car_fav_icon_size"
                    android:layout_height="@dimen/car_fav_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="收藏当前电台"
                    android:duplicateParentState="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/fav_icon_tint_car" />
            </FrameLayout>
        </LinearLayout>

        <!-- 时段：这台频率的播出时间，次要信息 -->
        <TextView
            android:id="@+id/tv_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/car_space_4"
            android:includeFontPadding="false"
            android:text="00:00–24:00"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/car_text_period" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/car_space_2"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/car_text_subtitle" />

        <!--
          节目时间轴：直播没有真实进度，用「当天 0 点到现在」的位置表示刻度走到哪。
          这是本界面的签名细节：一条调频刻度（轨道 + 橙色指针 + 此刻气泡）。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/car_space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="00:00:00"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/car_text_timeline" />

            <TextView
                android:id="@+id/tv_timeline_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/time_chip"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/car_space_8"
                android:paddingTop="@dimen/car_space_3"
                android:paddingEnd="@dimen/car_space_8"
                android:paddingBottom="@dimen/car_space_3"
                android:text="--:--:--"
                android:textColor="@color/accent_deep"
                android:textSize="@dimen/car_text_timeline" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="24:00:00"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/car_text_timeline" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_timeline"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/car_progress_height"
            android:layout_marginTop="@dimen/car_space_6"
            android:max="1440"
            android:progress="0"
            android:progressDrawable="@drawable/timeline_progress" />

        <!-- 播放状态：「正载入…」「正在直播」「网络失败」等，代码里 setText -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/car_space_8"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="正载入…"
            android:textColor="@color/accent_deep"
            android:textSize="@dimen/car_text_status" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          按钮行：固定高度，不参与压缩。
          图标全是矢量（U+23EE / U+25B6 这类字符要靠设备字体，国产 ROM 会丢字变方框）。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/car_btn_height"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_prev"
                style="@style/CtrlButton"
                android:contentDescription="上一台"
                android:nextFocusUp="@id/btn_fav_playing">

                <ImageView
                    style="@style/CtrlButtonIcon"
                    android:contentDescription="上一台"
                    android:src="@drawable/ic_skip_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_play"
                style="@style/CtrlButtonPrimary"
                android:contentDescription="播放">

                <ImageView
                    android:id="@+id/btn_play_label"
                    style="@style/CtrlButtonIcon"
                    android:contentDescription="播放"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_next"
                style="@style/CtrlButton"
                android:contentDescription="下一台"
                android:nextFocusRight="@id/list_stations"
                android:nextFocusUp="@id/btn_fav_playing">

                <ImageView
                    style="@style/CtrlButtonIcon"
                    android:contentDescription="下一台"
                    android:src="@drawable/ic_skip_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 右：电台列表卡 ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="54"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/car_space_12"
        android:paddingTop="@dimen/car_space_12"
        android:paddingEnd="@dimen/car_space_12"
        android:paddingBottom="@dimen/car_space_12">

        <!--
          顶栏一行：状态提示（弹性）+ 版本 / 主题 / 隐藏 / 更新 / 诊断 / 地区。

          v2.1：几个小胶囊同高（Material 建议的最小触控边长，
          v2.0 的 36dp 在方向盘扫视 / 颠簸时偏难点准）、同字号。
          地区是这一行唯一的主操作，用橙字 + 浅橙底把它托出来；
          外观按钮显示「自动 / 白天 / 夜间」，点一下循环三档。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/car_toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_media_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="0dp"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/car_text_hint" />

            <!-- 版本号徽标：一直显示，点开是「关于」（版本码 / 渠道 / 更新地址） -->
            <TextView
                android:id="@+id/text_version"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/region_bg"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/car_space_10"
                android:paddingEnd="@dimen/car_space_10"
                android:text="v-"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/car_text_version" />

            <!--
              v2.1 白天 / 夜间 / 跟随系统：点一下循环，文字直接显示当前档。
              用文字不用字符图标 —— 车机字体库裁过 emoji 与月相字形，
              「自动 / 白天 / 夜间」三个词在任何机器上都不会变方框。
            -->
            <TextView
                android:id="@+id/btn_theme"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/region_bg"
                android:contentDescription="外观模式，点击切换"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/car_space_12"
                android:paddingEnd="@dimen/car_space_12"
                android:text="自动"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/car_text_toolbar" />

            <TextView
                android:id="@+id/btn_manage"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/region_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/car_space_12"
                android:paddingEnd="@dimen/car_space_12"
                android:text="隐藏"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/car_text_toolbar" />

            <!-- 检查更新：点一下才查，不做启动静默检查（按用户选择） -->
            <TextView
                android:id="@+id/btn_update"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/region_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/car_space_12"
                android:paddingEnd="@dimen/car_space_12"
                android:text="更新"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/car_text_toolbar" />

            <TextView
                android:id="@+id/btn_log"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/region_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="@dimen/car_space_12"
                android:paddingEnd="@dimen/car_space_12"
                android:text="诊断"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/car_text_toolbar" />

            <!-- 地区：主操作，橙字浅橙底 -->
            <TextView
                android:id="@+id/tv_region"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/car_toolbar_height"
                android:layout_marginStart="@dimen/car_space_8"
                android:background="@drawable/accent_chip"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="@dimen/car_region_max_width"
                android:paddingStart="@dimen/car_space_14"
                android:paddingEnd="@dimen/car_space_14"
                android:text="四川 ▾"
                android:textColor="@color/accent_deep"
                android:textSize="@dimen/car_text_region" />
        </LinearLayout>

        <!--
          「全部 / 收藏」：两枚等宽胶囊。选中橙底白字，未选中浅灰底次级字。
          实体胶囊比下划线更适合车机 —— 手指按大块比按细线容易。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/car_tab_height"
            android:layout_marginTop="@dimen/car_space_12"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/tab_on"
                android:focusable="true"
                android:gravity="center"
                android:text="全部电台"
                android:textColor="@color/icon_on_accent"
                android:textSize="@dimen/car_text_tab" />

            <TextView
                android:id="@+id/tab_fav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/car_space_8"
                android:layout_weight="1"
                android:background="@drawable/tab_off"
                android:focusable="true"
                android:gravity="center"
                android:text="我的收藏"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/car_text_tab" />
        </LinearLayout>

        <ListView
            android:id="@+id/list_stations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/car_space_8"
            android:layout_weight="1"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
