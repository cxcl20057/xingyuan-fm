<?xml version="1.0" encoding="utf-8"?>
<!--
  「正在直播」的小圆点（8dp）。

  取代原来的字符「●」：字符要靠字体提供 glyph，国产 ROM 字体裁剪不一，
  而且字符的直径不可控（不同字号下偏大偏小）。用一个固定 8dp 的圆，
  在任何机器上都是同一个大小。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/accent" />
</shape>
