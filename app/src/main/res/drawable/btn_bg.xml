<?xml version="1.0" encoding="utf-8"?>
<!--
  车机控制键的次要两枚（上一台 / 下一台）：浅灰底、24dp 圆角。

  为什么不做成正圆：这两个键宽度由 weight 等分（约 120dp），做成 circle 会变椭圆，
  反而比圆角矩形更晃眼。喜马拉雅的做法也是「胶囊 + 无边框」，视觉重量压在图标上。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_pressed" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_muted" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
