<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  车机两栏版面 · 低密度真车放大值（sw>=1080dp）
  ============================================================

  实测星愿车机（IHU801G / E22H___5，Android 9）：
    物理 1920×1080px，密度 160 dpi（mdpi，density=1.0），
    可用内容区 1920×968dp，整屏最小宽 sw=1080dp。

  1dp 物理尺寸恒定（=1/160 英寸），所以这台车与「xhdpi 2x 车机」物理分辨率相同、
  但 dp 总量是后者的 2 倍（960dp→1920dp 宽、540dp→968dp 高）。同一套 dp 值在
  1x 屏幕上只会显示成一半大。因此这里把 values/dimens.xml 的全部车机尺寸放大一倍，
  让物理观感回到与 2x 车机一致。

  Carlink 投屏虚拟屏（3200×1600 @2.25 ⇒ 1422×711dp，sw≈711dp）不命中本目录，
  仍走 values/dimens.xml 原值，投屏列表行数不受影响。
-->
<resources>

    <!-- ==================== 字号（sp） ==================== -->

    <dimen name="car_text_logo">120sp</dimen>
    <dimen name="car_text_station">68sp</dimen>
    <dimen name="car_text_station_min">44sp</dimen>
    <dimen name="car_text_live">28sp</dimen>
    <dimen name="car_text_period">32sp</dimen>
    <dimen name="car_text_subtitle">30sp</dimen>
    <dimen name="car_text_timeline">26sp</dimen>
    <dimen name="car_text_status">28sp</dimen>
    <dimen name="car_text_hint">24sp</dimen>
    <dimen name="car_text_version">19.5sp</dimen>
    <dimen name="car_text_toolbar">21sp</dimen>
    <dimen name="car_text_region">22.5sp</dimen>
    <dimen name="car_text_tab">28sp</dimen>
    <dimen name="car_text_item_title">44sp</dimen>
    <dimen name="car_text_item_sub">28sp</dimen>
    <dimen name="car_text_item_no">32sp</dimen>

    <!-- ==================== 控件尺寸（dp） ==================== -->

    <dimen name="car_logo_size">280dp</dimen>
    <dimen name="car_dot_live">16dp</dimen>
    <dimen name="car_fav_btn_size">96dp</dimen>
    <dimen name="car_fav_icon_size">48dp</dimen>
    <dimen name="car_btn_height">158dp</dimen>
    <dimen name="car_btn_icon_size">60dp</dimen>
    <dimen name="car_toolbar_height">72dp</dimen>
    <dimen name="car_tab_height">78dp</dimen>
    <dimen name="car_item_height">132dp</dimen>
    <dimen name="car_cover_size">60dp</dimen>
    <dimen name="car_mark_width">6dp</dimen>
    <dimen name="car_mark_height">56dp</dimen>
    <dimen name="car_progress_height">12dp</dimen>
    <dimen name="car_item_icon_size">96dp</dimen>
    <dimen name="car_region_max_width">300dp</dimen>

    <!-- ==================== 间距（dp） ==================== -->

    <dimen name="car_space_2">4dp</dimen>
    <dimen name="car_space_3">6dp</dimen>
    <dimen name="car_space_4">8dp</dimen>
    <dimen name="car_space_6">12dp</dimen>
    <dimen name="car_space_8">16dp</dimen>
    <dimen name="car_space_10">20dp</dimen>
    <dimen name="car_space_12">24dp</dimen>
    <dimen name="car_space_14">28dp</dimen>
    <dimen name="car_space_15">30dp</dimen>
    <dimen name="car_space_16">32dp</dimen>
    <dimen name="car_space_20">40dp</dimen>

    <!-- 底部边距：保持 v2.2.2 的原边距，即默认值 12dp 的 2 倍。 -->
    <dimen name="car_pad_bottom">24dp</dimen>

</resources>
