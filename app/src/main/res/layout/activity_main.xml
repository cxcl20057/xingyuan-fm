<?xml version="1.0" encoding="utf-8"?>
<!--
  手机竖屏主界面（可用宽度 < 600dp：普通手机、折叠屏折叠态、车机小窗）。

  ============================================================
  v2.0 版面重做（参考喜马拉雅 FM）
  ============================================================

  <h3>结构</h3>
    ① 标题行：应用名（@string/app_name，Carlink 版自动是「星愿 FM」）+ 地区
    ② 工具行：状态提示 + 版本 / 隐藏 / 更新 / 诊断（一行安静的小胶囊）
    ③ 全部 / 收藏：两枚等宽胶囊，选中橙底白字
    ④ 列表：吃掉全部剩余高度 —— 手机上列表才是主角
    ⑤ 底部播放条（白卡）：台标 44dp + 台名/副标题 + 直播标，下面一排
       上一台 / 播放 / 下一台 / 收藏 四个圆钮，最底一行时间轴 + 状态

  <h3>为什么台标必须写 44dp</h3>
  {@code PhoneLayout.isMiniBar()} 的判据就是「布局里的台标宽度 ≤ miniLogoSizeDp（44dp）」。
  写成 48dp 会被判成"不是迷你条"，于是走 {@code logoSizeDp()} 那一支，
  在手机上被放大到 110~160dp，整条播放条会被撑爆。改尺寸要么动 miniLogoSizeDp，
  要么两边一起改，不要只改这里。

  <h3>行高不要写死</h3>
  item_station.xml 里的高度只是预览值，运行时由 PhoneLayout.rowHeightPx() 覆盖
  （手机 56dp、短边 ≥ 420dp 时 64dp）。

  <h3>文案</h3>
  顶栏不再用「FM」+ 大字距的装饰标签，直接显示应用名 ——
  同一台手机上正式版叫「星愿收音机」、Carlink 版叫「星愿 FM」，
  一眼能分清打开的是哪个。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- ① 标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <!-- 地区：主操作，橙字浅橙底 -->
        <TextView
            android:id="@+id/tv_region"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/accent_chip"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="四川 ▾"
            android:textColor="@color/accent_deep"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ② 工具行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_media_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="0dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- 版本号徽标：点开是「关于」（版本码 / 渠道 / 更新地址） -->
        <TextView
            android:id="@+id/text_version"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/region_bg"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="v-"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- v2.1：白天 / 夜间 / 跟随系统，点一下循环 -->
        <TextView
            android:id="@+id/btn_theme"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/region_bg"
            android:contentDescription="外观模式，点击切换"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="自动"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_manage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/region_bg"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="隐藏"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_update"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/region_bg"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="更新"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_log"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/region_bg"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="诊断"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ③ 全部 / 收藏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/tab_on"
            android:focusable="true"
            android:gravity="center"
            android:text="全部电台"
            android:textColor="@color/icon_on_accent"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tab_fav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tab_off"
            android:focusable="true"
            android:gravity="center"
            android:text="我的收藏"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ④ 列表：吃掉所有剩余高度 -->
    <ListView
        android:id="@+id/list_stations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:choiceMode="singleChoice"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <!--
      ⑤ 底部播放条（白卡）。
      id=panel_left 沿用旧名字，这样 SwipeStationHelper / MainActivity 两套布局用同一套 id，
      不必到处判断"是手机还是车机"。条本身不 clickable，滑动换台不会被抢。
    -->
    <LinearLayout
        android:id="@+id/panel_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- 第一行：台标 + 台名/副标题 + 直播标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/logo_wrap"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/logo_circle">

                <TextView
                    android:id="@+id/tv_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="川"
                    android:textColor="@color/on_light"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/logo_clip"
                    android:clipToOutline="true"
                    android:contentDescription="电台台标"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_station"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 直播标：浅橙底 + 深橙字，与车机版的圆点标记同一套语言 -->
            <TextView
                android:id="@+id/tv_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/time_chip"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="直播"
                android:textColor="@color/accent_deep"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 第二行：四个圆钮，主播放键大一圈、橙底 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_prev"
                style="@style/MiniCtrlButton"
                android:contentDescription="上一台">

                <ImageView
                    style="@style/MiniCtrlIcon"
                    android:contentDescription="上一台"
                    android:src="@drawable/ic_skip_previous" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_play"
                style="@style/MiniCtrlButtonPrimary"
                android:contentDescription="播放">

                <ImageView
                    android:id="@+id/btn_play_label"
                    style="@style/MiniCtrlIcon"
                    android:contentDescription="播放"
                    android:src="@drawable/ic_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_next"
                style="@style/MiniCtrlButton"
                android:contentDescription="下一台">

                <ImageView
                    style="@style/MiniCtrlIcon"
                    android:contentDescription="下一台"
                    android:src="@drawable/ic_skip_next" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_fav_playing"
                style="@style/MiniCtrlButton"
                android:contentDescription="收藏当前电台">

                <ImageView
                    android:id="@+id/iv_fav_playing"
                    style="@style/MiniFavIcon"
                    android:contentDescription="收藏当前电台"
                    android:src="@drawable/ic_favorite_border" />
            </FrameLayout>
        </LinearLayout>

        <!--
          第三行：时间轴 + 状态。
          tv_status 必须留 maxWidth：它显示「载入中…」「24 个电台」「网络失败，已载入缓存」
          这类不定长文字，无上限会把时间轴挤成 0 宽、甚至顶出播放条右边界。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="00:00–24:00"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/progress_timeline"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1440"
                android:progress="0"
                android:progressDrawable="@drawable/timeline_progress" />

            <TextView
                android:id="@+id/tv_timeline_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="--:--"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="88dp"
                android:text="载入中…"
                android:textColor="@color/accent_deep"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
