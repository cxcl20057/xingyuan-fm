<Slide style={{ padding: 60, background: '#FFFFFF' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1F2937' }}>镜头 4 · 手机双主题</Text>
    <Box style={{ paddingTop: 5, paddingBottom: 5, paddingLeft: 14, paddingRight: 14, background: '#FFF3EA', borderRadius: 20 }}>
      <Text style={{ fontSize: 16, color: '#FF6600', fontWeight: 'bold' }}>18 – 24 秒</Text>
    </Box>
  </Box>
  <Box style={{ height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 40 }} />
  <Box style={{ flexDirection: 'row', gap: 48, alignItems: 'center' }}>
    <Box style={{ flexDirection: 'row', gap: 24, alignItems: 'center' }}>
      <Box style={{ flexDirection: 'column', gap: 14, alignItems: 'center' }}>
        <Image src="assets/phone_light.jpg" style={{ width: 209, height: 460, borderRadius: 12, border: '1px solid #E5E7EB' }} />
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FF6600' }}>白天</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 14, alignItems: 'center' }}>
        <Image src="assets/phone_dark.jpg" style={{ width: 209, height: 460, borderRadius: 12, border: '1px solid #E5E7EB' }} />
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F2937' }}>夜间</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
      <Text style={{ fontSize: 20, color: '#6B7280' }}>画面</Text>
      <Text style={{ fontSize: 24, color: '#1F2937', lineHeight: 1.5 }}>手机竖屏单列布局，白天 / 夜间双主题并排</Text>
      <Text style={{ fontSize: 20, color: '#6B7280', marginTop: 10 }}>旁白 / 字幕</Text>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FF6600', lineHeight: 1.45 }}>「手机同样好用，白天、夜间双主题随环境切换」</Text>
      <Text style={{ fontSize: 20, color: '#6B7280', marginTop: 10 }}>运镜 / 转场</Text>
      <Text style={{ fontSize: 24, color: '#1F2937' }}>双图并排，交叉淡化</Text>
    </Box>
  </Box>
</Slide>
